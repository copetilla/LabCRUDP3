{
  "realm": "lab1",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "accessTokenLifespan": 900,
  "roles": {
    "realm": [
      {
        "name": "SUPER-ADMIN-ROLE"
      },
      {
        "name": "USER"
      }
    ]
  },
  "clients": [
    {
      "clientId": "lab1-api",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "profile",
        "email",
        "roles"
      ]
    }
  ],
  "users": [
    {
      "username": "superadmin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Administrador",
      "lastName": "Lab",
      "email": "superadmin@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "admin123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "SUPER-ADMIN-ROLE"
      ]
    },
    {
      "username": "usuario",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Usuario",
      "lastName": "Lab",
      "email": "usuario@example.com",
      "credentials": [
        {
          "type": "password",
          "value": "usuario123",
          "temporary": false
        }
      ],
      "realmRoles": [
        "USER"
      ]
    }
  ]
}